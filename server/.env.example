# Copy this file to `.env` and fill in real values. NEVER commit the real .env
# (it is gitignored). On a host, set these as environment variables or upload
# your own .env — do not put real secrets in this example file.

# ============================================================
#  CORE
# ============================================================
PORT=4000
NODE_ENV=development

# ============================================================
#  DEPLOY URLs  — fill these in AFTER you deploy
# ------------------------------------------------------------
#  CLIENT_ORIGIN = your deployed FRONTEND (Next.js) URL.
#  Comma-separate to allow several (e.g. preview + prod).
#  Local dev: http://localhost:3000
# ============================================================
CLIENT_ORIGIN=__DEPLOYED_FRONTEND_URL__

# ============================================================
#  AUTH
# ============================================================
# REQUIRED in production: a long random secret used to sign JWTs.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ============================================================
#  DATABASE (MongoDB)
#  Local:  mongodb://localhost:27017/healthos
#  Atlas:  mongodb+srv://user:pass@cluster.mongodb.net/healthos
# ============================================================
MONGODB_URI=mongodb://localhost:27017/healthos
MONGODB_DB=healthos

# ============================================================
#  EMAIL (OTP verification + SOS alerts)
#  PRODUCTION: most hosts (Render free tier) block outbound SMTP,
#  so use Brevo's HTTP API — set BREVO_API_KEY and it takes priority.
#    1. Free account: https://www.brevo.com (300 emails/day)
#    2. Verify a sender address (Senders), 3. create an API key.
#  LOCAL DEV: Gmail SMTP works — fill SMTP_USER + a Google App
#  Password. Leave all blank to print codes to the console.
# ============================================================
BREVO_API_KEY=
EMAIL_FROM_NAME=HealthOS
SMTP_USER=
SMTP_PASS=
# Optional — only for non-Gmail providers (else Gmail is auto-detected):
SMTP_HOST=
SMTP_PORT=
# Optional — defaults to SMTP_USER:
SMTP_FROM=

# ============================================================
#  GOOGLE OAUTH (optional — "Continue with Google" appears only
#  once CLIENT_ID + CLIENT_SECRET are set). Create an OAuth 2.0
#  Web client in Google Cloud Console.
#  Authorized redirect URI must match GOOGLE_REDIRECT_URI below:
#    local: http://localhost:4000/api/auth/google/callback
#    prod:  <DEPLOYED_BACKEND_URL>/api/auth/google/callback
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=__DEPLOYED_BACKEND_URL__/api/auth/google/callback

# ============================================================
#  WEB PUSH (free browser push notifications — alerts with the
#  site closed). Generate keys once with:
#    node -e "console.log(require('web-push').generateVAPIDKeys())"
#  Leave blank to disable push (siren/toasts still work in-tab).
# ============================================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ============================================================
#  AI HEALTH COPILOT (OpenRouter)
#  Get a key at https://openrouter.ai/keys. Leave blank to
#  disable AI — the chatbot falls back to rule-based answers.
# ============================================================
OPENROUTER_API_KEY=
# Any model slug from https://openrouter.ai/models (":free" variants cost nothing).
OPENROUTER_MODEL=openai/gpt-oss-120b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Used for OpenRouter attribution — set to your deployed frontend URL in prod.
OPENROUTER_APP_URL=__DEPLOYED_FRONTEND_URL__
OPENROUTER_APP_TITLE=HealthOS
