# Copy to .env and adjust. Never commit the real .env.
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed browser origins (the Next.js client).
CLIENT_ORIGIN=http://localhost:3000

# REQUIRED in production: a long random secret used to sign JWTs.
JWT_SECRET=dev-only-change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# MongoDB connection. Local: mongodb://localhost:27017/healthos
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/healthos
MONGODB_URI=mongodb://localhost:27017/healthos
MONGODB_DB=healthos
