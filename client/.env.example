# Copy this file to `.env.local` and fill in real values. `.env.local` is
# gitignored. All client vars MUST be prefixed NEXT_PUBLIC_ to be exposed to the
# browser, and the client must be rebuilt after changing them.

# ============================================================
#  DEPLOY URLs — fill these in AFTER you deploy
# ------------------------------------------------------------
#  NEXT_PUBLIC_API_URL  = your deployed BACKEND (Express) URL.
#  Drives both the REST API and the Socket.IO realtime link.
#  Local dev: http://localhost:4000
# ============================================================
NEXT_PUBLIC_API_URL=__DEPLOYED_BACKEND_URL__

# This site's own public URL (used for SEO: canonical, robots, sitemap).
# Set to your deployed FRONTEND URL. Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=__DEPLOYED_FRONTEND_URL__

# ============================================================
#  GOOGLE MAPS (optional)
#  Maps JavaScript API + Places API (New) enabled, billing on.
#  Leave blank to use the free OpenStreetMap/Leaflet fallback.
# ============================================================
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional Cloud "Map ID" for custom styling (AdvancedMarkers). Defaults to DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAP_ID=
